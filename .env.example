# Local development settings. Everything here is optional except the engine secret.
#
# Web app:  cp .env.example apps/web/.env.local   (Next.js reads apps/web/.env*)
# Engine:   export ENGINE_SHARED_SECRET=... before `uv run` (or pass it inline)
# Docker:   cp .env.example .env                  (docker compose reads the root .env)
# All .env* files except this one are git-ignored and blocked by the pre-commit guard.

# Shared secret the web API layer sends to the engine (must match on both sides).
ENGINE_SHARED_SECRET=local-dev-secret
ENGINE_URL=http://localhost:8000

# SQLite file used by `pnpm db:*` (default: <repo>/var/app.db)
# DATABASE_PATH=/absolute/path/to/app.db

# Narration: template (default, no key) | anthropic | openai-compatible  (Phase 4)
NARRATOR=template
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
