{
  "name": "grahrekha",
  "private": true,
  "description": "Open-source AI-assisted palmistry (Hast Rekha) and Vedic astrology research platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "turbo run dev --filter=@grahrekha/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @grahrekha/db migrate",
    "db:reset": "pnpm --filter @grahrekha/db reset",
    "contracts:gen": "pnpm --filter @grahrekha/contracts gen",
    "check:no-binaries": "bash scripts/check-no-binaries.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
