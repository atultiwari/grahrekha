# Copy to .env.local (git-ignored). Everything is optional for local development.

# Engine service (web → engine)
ENGINE_URL=http://localhost:8000
ENGINE_SHARED_SECRET=change-me-local-only

# Database (SQLite file, created by `pnpm db:reset`)
DATABASE_URL=file:../../var/app.db

# Narration: template (default, no key) | anthropic | openai-compatible
NARRATOR=template
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
